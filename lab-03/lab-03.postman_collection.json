{
  "info": {
    "name": "lab-03",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "newBookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Success Cases",
      "item": [
        {
          "name": "01 GET all books (defaults, limit 10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('Body is correct', function () { pm.expect(j).to.be.an('array'); pm.expect(j.length).to.be.at.most(10); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/"
            }
          }
        },
        {
          "name": "02 GET one book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('Body is correct', function () { pm.expect(j.id).to.eql(3); pm.expect(j).to.have.all.keys('id','title','author','price','pages'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/3/"
            }
          }
        },
        {
          "name": "03 Search by title (search_q=the)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('Body is correct', function () { pm.expect(j.length).to.be.above(0); j.forEach(b => pm.expect(b.title.toLowerCase()).to.include('the')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/?search_q=the"
            }
          }
        },
        {
          "name": "04 Sort by price descending",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('Body is correct', function () { pm.expect(j.length).to.eql(5); for (let i=1;i<j.length;i++) pm.expect(j[i-1].price).to.be.at.least(j[i].price); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/?order_by=price&order=DESC&limit=5"
            }
          }
        },
        {
          "name": "05 Pagination (limit=3, offset=3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('Body is correct', function () { pm.expect(j.length).to.eql(3); pm.expect(j[0].id).to.eql(4); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/?limit=3&offset=3"
            }
          }
        },
        {
          "name": "06 Price range (min_price=300, max_price=450)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('Body is correct', function () { j.forEach(b => { pm.expect(b.price).to.be.within(300,450); }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/?min_price=300&max_price=450"
            }
          }
        },
        {
          "name": "07 All filters together",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('Body is correct', function () { pm.expect(j.length).to.be.at.most(3); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/?search_q=o&min_price=250&max_price=500&order_by=pages&order=DESC&limit=3&offset=1"
            }
          }
        },
        {
          "name": "08 SQL injection text in search is harmless",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('Body is correct', function () { pm.expect(j).to.eql([]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/?search_q=%27%20OR%201%3D1%20--"
            }
          }
        },
        {
          "name": "09 POST create a book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.test('Message mentions Book added', function () { pm.expect(j.message).to.include(\"Book added\"); });",
                  "pm.test('Body is correct', function () { pm.expect(j.bookId).to.be.a('number'); pm.collectionVariables.set('newBookId', j.bookId); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Deep Work\",\n  \"author\": \"Cal Newport\",\n  \"price\": 450,\n  \"pages\": 304\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "10 PUT update the new book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
