                  "const j = pm.response.json();",
                  "pm.test('Message mentions Book updated', function () { pm.expect(j.message).to.include(\"Book updated\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{newBookId}}/"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Deep Work (Updated)\",\n  \"author\": \"Cal Newport\",\n  \"price\": 399,\n  \"pages\": 310\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
